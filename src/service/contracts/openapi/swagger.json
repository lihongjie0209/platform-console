{
    "openapi": "3.0.0",
    "info": {
        "description": "Discovers and aggregates platform OpenAPI documents. Application error codes: 0 success; 10000-19999 common/input; 20000-29999 authentication/authorization; 30000-39999 business; 50000-59999 infrastructure.",
        "title": "Platform Swagger Service API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/api/v1/me": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "tags": [
                    "authentication"
                ],
                "summary": "Return the authenticated subject",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/httptransport.MeResponseBody"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Code 20001: unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httptransport.Response"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/swagger/services": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "tags": [
                    "OpenAPI aggregation"
                ],
                "summary": "List discovered OpenAPI services",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/httptransport.ListSwaggerServicesRequest"
                            }
                        }
                    },
                    "description": "Empty request",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/httptransport.SwaggerServicesBody"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Code 20001: unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httptransport.Response"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Code 20003: forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httptransport.Response"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/swagger/spec": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "tags": [
                    "OpenAPI aggregation"
                ],
                "summary": "Get one aggregated OpenAPI document",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/httptransport.GetSwaggerSpecRequest"
                            }
                        }
                    },
                    "description": "Service source name",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/httptransport.SwaggerSpecBody"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Code 10001: invalid request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httptransport.Response"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Code 20001: unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httptransport.Response"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Code 20003: forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httptransport.Response"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Code 10004: source not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httptransport.Response"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Code 50003: source unavailable",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httptransport.Response"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/version": {
            "post": {
                "tags": [
                    "operations"
                ],
                "summary": "Return build and runtime version information",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/buildinfo.Info"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/live": {
            "post": {
                "tags": [
                    "operations"
                ],
                "summary": "Check process liveness",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/health.Status"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/ready": {
            "post": {
                "tags": [
                    "operations"
                ],
                "summary": "Check database and Redis readiness",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/health.Status"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Code 50003: dependency unavailable",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/health.Status"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "servers": [
        {
            "url": "/"
        }
    ],
    "components": {
        "securitySchemes": {
            "Bearer": {
                "description": "Enter \"Bearer {JWT}\".",
                "type": "apiKey",
                "name": "Authorization",
                "in": "header"
            },
            "PSK": {
                "description": "Enter \"PSK {shared-key}\" for routes configured with PSK authentication.",
                "type": "apiKey",
                "name": "Authorization",
                "in": "header"
            }
        },
        "schemas": {
            "buildinfo.Info": {
                "type": "object",
                "properties": {
                    "build_time": {
                        "type": "string"
                    },
                    "commit": {
                        "type": "string"
                    },
                    "started_at": {
                        "type": "string"
                    },
                    "uptime": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    }
                }
            },
            "catalog.Source": {
                "type": "object",
                "properties": {
                    "available": {
                        "type": "boolean"
                    },
                    "error": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "origin": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "updated_at": {
                        "type": "string"
                    }
                }
            },
            "health.Dependency": {
                "type": "object",
                "properties": {
                    "latency": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    }
                }
            },
            "health.Status": {
                "type": "object",
                "properties": {
                    "dependencies": {
                        "type": "object",
                        "additionalProperties": {
                            "$ref": "#/components/schemas/health.Dependency"
                        }
                    },
                    "status": {
                        "type": "string"
                    }
                }
            },
            "httptransport.GetSwaggerSpecRequest": {
                "type": "object",
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "platform--identity-service"
                    }
                }
            },
            "httptransport.ListSwaggerServicesRequest": {
                "type": "object"
            },
            "httptransport.MeResponseBody": {
                "type": "object",
                "properties": {
                    "subject": {
                        "type": "string"
                    }
                }
            },
            "httptransport.Response": {
                "type": "object",
                "properties": {
                    "body": {},
                    "code": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "request_id": {
                        "type": "string"
                    }
                }
            },
            "httptransport.SwaggerServicesBody": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/catalog.Source"
                        }
                    }
                }
            },
            "httptransport.SwaggerSpecBody": {
                "type": "object",
                "properties": {
                    "document": {
                        "type": "object",
                        "additionalProperties": {}
                    },
                    "name": {
                        "type": "string"
                    }
                }
            }
        }
    }
}