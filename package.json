{
  "name": "@platform/console",
  "type": "module",
  "version": "1.4.0",
  "packageManager": "pnpm@11.21.0",
  "description": "Unified platform and business-system management console.",
  "author": {
    "name": "lihongjie0209",
    "url": "https://github.com/lihongjie0209"
  },
  "license": "MIT",
  "homepage": "https://github.com/lihongjie0209/platform-console",
  "repository": {
    "url": "https://github.com/lihongjie0209/platform-console.git"
  },
  "bugs": {
    "url": "https://github.com/lihongjie0209/platform-console/issues"
  },
  "keywords": [
    "Vue3 admin ",
    "vue-admin-template",
    "Vite7",
    "rolldown-vite",
    "TypeScript",
    "element-plus",
    "element-plus-admin",
    "UnoCSS"
  ],
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.7.0"
  },
  "scripts": {
    "build": "vite build --mode prod",
    "build:test": "vite build --mode test",
    "check:application-boundaries": "node scripts/check-application-boundaries.mjs",
    "check:application-chunks": "node scripts/check-application-chunks.mjs",
    "check:application-scope": "node scripts/check-application-scope.mjs",
    "check:contracts": "node scripts/check-contract-types.mjs",
    "check:product-surface": "node scripts/check-product-surface.mjs",
    "check:runtime-config": "node scripts/check-runtime-config.mjs",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "commit:zh": "sa git-commit -l=zh-cn",
    "dev": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "gen-route": "sa gen-route",
    "generate:contracts": "node scripts/generate-contract-types.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postbuild": "sa print-soybean",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "release": "sa release",
    "test": "tsx --test src/components/business/crud/*.test.ts src/components/business/common/*.test.ts src/platform/*.test.ts src/apps/*.test.ts src/apps/platform-admin/*.test.ts src/apps/config-center/*.test.ts src/apps/notification-center/*.test.ts src/apps/file-center/*.test.ts src/apps/scheduler-center/*.test.ts src/apps/dictionary-center/*.test.ts src/apps/workflow-center/*.test.ts src/apps/swagger-center/*.test.ts src/apps/billing-center/*.test.ts src/apps/export-center/*.test.ts src/apps/import-center/*.test.ts",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "update-pkg": "sa update-pkg"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.1",
    "@iconify/vue": "5.0.0",
    "@sa/alova": "workspace:*",
    "@sa/axios": "workspace:*",
    "@sa/color": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/utils": "workspace:*",
    "@visactor/vchart": "2.0.20",
    "@visactor/vchart-theme": "1.12.3",
    "@visactor/vue-vtable": "1.25.0",
    "@vueuse/components": "14.2.1",
    "@vueuse/core": "14.2.1",
    "clipboard": "2.0.11",
    "dayjs": "1.11.20",
    "defu": "^6.1.4",
    "echarts": "6.0.0",
    "element-plus": "^2.13.6",
    "hash-wasm": "^4.12.0",
    "json5": "2.2.3",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "print-js": "1.6.0",
    "tailwind-merge": "3.5.0",
    "vue": "3.5.31",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.3.0",
    "vue-router": "5.0.4",
    "wangeditor": "4.7.15"
  },
  "devDependencies": {
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.458",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@soybeanjs/eslint-config": "1.7.5",
    "@types/node": "25.5.0",
    "@types/nprogress": "0.2.3",
    "@unocss/eslint-config": "66.6.7",
    "@unocss/preset-icons": "66.6.7",
    "@unocss/preset-uno": "66.6.7",
    "@unocss/transformer-directives": "66.6.7",
    "@unocss/transformer-variant-group": "66.6.7",
    "@unocss/vite": "66.6.7",
    "@vitejs/plugin-vue": "6.0.5",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "consola": "3.4.2",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.6.2",
    "kolorist": "1.8.0",
    "openapi-typescript": "7.13.0",
    "sass": "1.98.0",
    "simple-git-hooks": "2.13.1",
    "swagger2openapi": "7.0.8",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "unplugin-auto-import": "21.0.0",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.0.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "8.1.1",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.2.6"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm sa git-commit-verify",
    "pre-commit": "pnpm typecheck && pnpm lint && git diff --exit-code"
  },
  "website": "https://elp.soybeanjs.cn"
}
