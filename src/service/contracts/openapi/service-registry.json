{
    "openapi": "3.0.0",
    "info": {
        "description": "Production-oriented Go Web API scaffold. Application error codes: 0 success; 10000-19999 common/input; 20000-29999 authentication/authorization; 30000-39999 business; 50000-59999 infrastructure.",
        "title": "Go API Template",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/api/v1/me": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "tags": [
                    "authentication"
                ],
                "summary": "Return the authenticated subject",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/httptransport.MeResponseBody"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Code 20001: unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httptransport.Response"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/registry/instances/list": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "tags": [
                    "registry"
                ],
                "summary": "List live service instances",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/httptransport.ListInstancesRequest"
                            }
                        }
                    },
                    "description": "Service name or metadata selector",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/httptransport.ListInstancesBody"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Code 10001: invalid selector",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httptransport.Response"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/registry/services/list": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "tags": [
                    "registry"
                ],
                "summary": "List registered services",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/httptransport.ListServicesRequest"
                            }
                        }
                    },
                    "description": "Optional service prefix",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/httptransport.ListServicesBody"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/version": {
            "post": {
                "tags": [
                    "operations"
                ],
                "summary": "Return build and runtime version information",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/buildinfo.Info"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/live": {
            "post": {
                "tags": [
                    "operations"
                ],
                "summary": "Check process liveness",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/health.Status"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/ready": {
            "post": {
                "tags": [
                    "operations"
                ],
                "summary": "Check database and Redis readiness",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/health.Status"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Code 50003: dependency unavailable",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/httptransport.Response"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "body": {
                                                    "$ref": "#/components/schemas/health.Status"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "servers": [
        {
            "url": "/"
        }
    ],
    "components": {
        "securitySchemes": {
            "Bearer": {
                "description": "Enter \"Bearer {JWT}\".",
                "type": "apiKey",
                "name": "Authorization",
                "in": "header"
            },
            "PSK": {
                "description": "Enter \"PSK {shared-key}\" for routes configured with PSK authentication.",
                "type": "apiKey",
                "name": "Authorization",
                "in": "header"
            }
        },
        "schemas": {
            "buildinfo.Info": {
                "type": "object",
                "properties": {
                    "build_time": {
                        "type": "string"
                    },
                    "commit": {
                        "type": "string"
                    },
                    "started_at": {
                        "type": "string"
                    },
                    "uptime": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    }
                }
            },
            "health.Dependency": {
                "type": "object",
                "properties": {
                    "latency": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    }
                }
            },
            "health.Status": {
                "type": "object",
                "properties": {
                    "dependencies": {
                        "type": "object",
                        "additionalProperties": {
                            "$ref": "#/components/schemas/health.Dependency"
                        }
                    },
                    "status": {
                        "type": "string"
                    }
                }
            },
            "httptransport.InstanceBody": {
                "type": "object",
                "properties": {
                    "endpoint": {
                        "type": "string"
                    },
                    "instance_id": {
                        "type": "string"
                    },
                    "lease_expires_at": {
                        "type": "string"
                    },
                    "metadata": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "protocol": {
                        "type": "string"
                    },
                    "service_name": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    },
                    "weight": {
                        "type": "integer"
                    }
                }
            },
            "httptransport.ListInstancesBody": {
                "type": "object",
                "properties": {
                    "instances": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/httptransport.InstanceBody"
                        }
                    },
                    "page": {
                        "type": "integer"
                    },
                    "page_size": {
                        "type": "integer"
                    },
                    "revision": {
                        "type": "integer"
                    },
                    "total": {
                        "type": "integer"
                    }
                }
            },
            "httptransport.ListInstancesRequest": {
                "type": "object",
                "properties": {
                    "include_draining": {
                        "type": "boolean"
                    },
                    "metadata": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "page": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "page_size": {
                        "type": "integer",
                        "maximum": 100,
                        "minimum": 1
                    },
                    "service_name": {
                        "type": "string"
                    }
                }
            },
            "httptransport.ListServicesBody": {
                "type": "object",
                "properties": {
                    "page": {
                        "type": "integer"
                    },
                    "page_size": {
                        "type": "integer"
                    },
                    "revision": {
                        "type": "integer"
                    },
                    "services": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/httptransport.ServiceSummaryBody"
                        }
                    },
                    "total": {
                        "type": "integer"
                    }
                }
            },
            "httptransport.ListServicesRequest": {
                "type": "object",
                "properties": {
                    "page": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "page_size": {
                        "type": "integer",
                        "maximum": 100,
                        "minimum": 1
                    },
                    "prefix": {
                        "type": "string"
                    }
                }
            },
            "httptransport.MeResponseBody": {
                "type": "object",
                "properties": {
                    "subject": {
                        "type": "string"
                    }
                }
            },
            "httptransport.Response": {
                "type": "object",
                "properties": {
                    "body": {},
                    "code": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "request_id": {
                        "type": "string"
                    }
                }
            },
            "httptransport.ServiceSummaryBody": {
                "type": "object",
                "properties": {
                    "draining_instances": {
                        "type": "integer"
                    },
                    "healthy_instances": {
                        "type": "integer"
                    },
                    "service_name": {
                        "type": "string"
                    }
                }
            }
        }
    }
}